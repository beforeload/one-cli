{
  "name": "one-cli",
  "version": "0.1.0",
  "description": "A small, auditable coding agent CLI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beforeload/one-cli.git"
  },
  "bugs": {
    "url": "https://github.com/beforeload/one-cli/issues"
  },
  "homepage": "https://github.com/beforeload/one-cli#readme",
  "bin": {
    "one-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration --no-file-parallelism",
    "check": "npm run typecheck && npm run test && npm run test:integration",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "one-cli",
    "cli",
    "openai-compatible"
  ],
  "dependencies": {
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
